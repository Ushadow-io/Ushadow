#!/usr/bin/env bash
#MISE description="Stop services for an environment"
#USAGE arg "[env]" help="Target environment: k8s, aca, or omit for docker (default: docker)"

set -euo pipefail

ENV="${usage_env:-docker}"

case "$ENV" in
  ""|docker|local)
    ENV_FILE=".env"
    ;;
  *)
    ENV_FILE=".env.$ENV"
    ;;
esac

echo "Deploy down → ${ENV:-docker}"

case "$ENV" in
  ""|docker|local)
    docker compose --env-file "$ENV_FILE" down
    ;;

  k8s)
    # Load env vars (KUBECONFIG override, namespace, etc.)
    if [[ -f "$ENV_FILE" ]]; then set -a; source "$ENV_FILE"; set +a; fi
    kubectl delete -f k8s/ --ignore-not-found
    ;;

  aca)
    # Scale to zero — load ACA vars from env file
    if [[ ! -f "$ENV_FILE" ]]; then
      echo "error: $ENV_FILE not found" >&2
      exit 1
    fi
    set -a; source "$ENV_FILE"; set +a
    az containerapp update \
      --name "${APP_NAME:?set APP_NAME in $ENV_FILE}" \
      --resource-group "${ACA_RESOURCE_GROUP:?set ACA_RESOURCE_GROUP in $ENV_FILE}" \
      --min-replicas 0 --max-replicas 0
    ;;

  *)
    echo "error: unknown environment '$ENV' — use docker, k8s, or aca" >&2
    exit 1
    ;;
esac
