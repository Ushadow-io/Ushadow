   "segments": [
    {
     "id": "rec-0204-a-0",
     "text": "I have news: I resigned from Brightwater Labs yesterday.",
     "speakerLabel": "S1",
     "start": "2026-02-04T09:30:00Z",
     "end": "2026-02-04T09:30:06Z"
    },
    {
     "id": "rec-0204-a-1",
     "text": "I now work at Northwind Analytics, I start there next Monday.",
     "speakerLabel": "S1",
     "start": "2026-02-04T09:30:08Z",
     "end": "2026-02-04T09:30:14Z"
    },
    {
     "id": "rec-0204-a-2",
     "text": "Wow. Who takes over Heron?",
     "speakerLabel": "S0",
     "start": "2026-02-04T09:30:16Z",
     "end": "2026-02-04T09:30:22Z"
    },
    {
     "id": "rec-0204-a-3",
     "text": "Raj's team at Brightwater takes over the Heron migration.",
     "speakerLabel": "S1",
     "start": "2026-02-04T09:30:24Z",
     "end": "2026-02-04T09:30:30Z"
    },
    {
     "id": "rec-0204-a-4",
     "text": "And I sent you the schema draft this morning, as promised.",
     "speakerLabel": "S1",
     "start": "2026-02-04T09:30:32Z",
     "end": "2026-02-04T09:30:38Z"
    },
    {
     "id": "rec-0204-a-5",
     "text": "Got it, thanks Maya.",
     "speakerLabel": "S0",
     "start": "2026-02-04T09:30:40Z",
