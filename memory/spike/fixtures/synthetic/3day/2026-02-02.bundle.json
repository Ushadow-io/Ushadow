 "transcripts": [
  {
   "recordingId": "rec-0202-a",
   "revision": "r1",
   "createdAt": "2026-02-02T09:01:34Z",
   "model": "synthetic",
   "speakers": [
    {
     "label": "S0",
     "role": "owner"
    },
    {
     "label": "S1",
     "role": "participant",
     "displayName": "Maya Lindqvist"
    }
   ],
   "segments": [
    {
     "id": "rec-0202-a-0",
     "text": "Morning Maya, how is the Heron migration going at Brightwater Labs?",
     "speakerLabel": "S0",
     "start": "2026-02-02T09:00:00Z",
     "end": "2026-02-02T09:00:06Z"
    },
    {
     "id": "rec-0202-a-1",
     "text": "Slowly. I am the only data engineer on it at Brightwater right now.",
     "speakerLabel": "S1",
     "start": "2026-02-02T09:00:08Z",
     "end": "2026-02-02T09:00:14Z"
    },
    {
     "id": "rec-0202-a-2",
     "text": "Are you still planning to keep Heron on MongoDB?",
     "speakerLabel": "S0",
     "start": "2026-02-02T09:00:16Z",
     "end": "2026-02-02T09:00:22Z"
    },
    {
     "id": "rec-0202-a-3",
     "text": "No, we decided this morning to move Heron to Postgres instead of MongoDB.",
     "speakerLabel": "S1",
     "start": "2026-02-02T09:00:24Z",
     "end": "2026-02-02T09:00:30Z"
    },
    {
     "id": "rec-0202-a-4",
     "text": "Good call. What is the deadline?",
     "speakerLabel": "S0",
     "start": "2026-02-02T09:00:32Z",
     "end": "2026-02-02T09:00:38Z"
    },
    {
     "id": "rec-0202-a-5",
     "text": "The Heron go-live deadline is the twenty-eighth of February.",
     "speakerLabel": "S1",
     "start": "2026-02-02T09:00:40Z",
     "end": "2026-02-02T09:00:46Z"
    },
    {
     "id": "rec-0202-a-6",
     "text": "Can you send me the new schema draft?",
     "speakerLabel": "S0",
     "start": "2026-02-02T09:00:48Z",
     "end": "2026-02-02T09:00:54Z"
    },
    {
     "id": "rec-0202-a-7",
     "text": "Yes, I will send you the schema draft by Friday.",
     "speakerLabel": "S1",
     "start": "2026-02-02T09:00:56Z",
     "end": "2026-02-02T09:01:02Z"
    }
   ]
  },
  {
   "recordingId": "rec-0202-b",
   "revision": "r1",
   "createdAt": "2026-02-02T13:01:10Z",
   "model": "synthetic",
   "speakers": [
    {
     "label": "S0",
     "role": "owner"
    },
    {
     "label": "S1",
     "role": "participant",
     "displayName": "Jonas Okafor"
    },
    {
     "label": "S2",
     "role": "media"
    }
   ],
   "segments": [
    {
     "id": "rec-0202-b-0",
     "text": "Are we still doing the Riverside half marathon on the fifteenth of March?",
     "speakerLabel": "S1",
     "start": "2026-02-02T13:00:00Z",
     "end": "2026-02-02T13:00:06Z"
    },
    {
     "id": "rec-0202-b-1",
     "text": "Yes, I signed us both up last night.",
     "speakerLabel": "S0",
     "start": "2026-02-02T13:00:08Z",
     "end": "2026-02-02T13:00:14Z"
    },
    {
     "id": "rec-0202-b-2",
     "text": "Coming up after the break, the traffic report for the ring road.",
     "speakerLabel": "S2",
     "start": "2026-02-02T13:00:16Z",
     "end": "2026-02-02T13:00:22Z"
    },
    {
     "id": "rec-0202-b-3",
     "text": "My left knee has been sore since Sunday, so I am resting it this week.",
     "speakerLabel": "S1",
     "start": "2026-02-02T13:00:24Z",
     "end": "2026-02-02T13:00:30Z"
    },
    {
     "id": "rec-0202-b-4",
     "text": "Take it easy. We can do short runs until it settles.",
     "speakerLabel": "S0",
     "start": "2026-02-02T13:00:32Z",
     "end": "2026-02-02T13:00:38Z"
    }
   ]
  },
  {
   "recordingId": "rec-0202-c",
   "revision": "r1",
   "createdAt": "2026-02-02T18:31:10Z",
   "model": "synthetic",
   "speakers": [
    {
     "label": "S0",
     "role": "owner"
    },
    {
     "label": "S1",
     "role": "participant",
     "displayName": "Lena"
    }
   ],
   "segments": [
    {
     "id": "rec-0202-c-0",
     "text": "Hi, it is Lena. Just calling from Leeds to say hello.",
     "speakerLabel": "S1",
     "start": "2026-02-02T18:30:00Z",
     "end": "2026-02-02T18:30:06Z"
    },
    {
     "id": "rec-0202-c-1",
     "text": "Hi sis. How is everyone in Leeds?",
     "speakerLabel": "S0",
     "start": "2026-02-02T18:30:08Z",
     "end": "2026-02-02T18:30:14Z"
    },
    {
     "id": "rec-0202-c-2",
     "text": "Good. Ivy turns six on the twentieth of February, she wants a party.",
     "speakerLabel": "S1",
     "start": "2026-02-02T18:30:16Z",
     "end": "2026-02-02T18:30:22Z"
    },
    {
     "id": "rec-0202-c-3",
     "text": "I will buy Ivy a telescope for her birthday, she loves the stars.",
     "speakerLabel": "S0",
     "start": "2026-02-02T18:30:24Z",
     "end": "2026-02-02T18:30:30Z"
    },
    {
     "id": "rec-0202-c-4",
     "text": "She will be thrilled.",
     "speakerLabel": "S1",
     "start": "2026-02-02T18:30:32Z",
     "end": "2026-02-02T18:30:38Z"
    }
   ]
  }
 ],
