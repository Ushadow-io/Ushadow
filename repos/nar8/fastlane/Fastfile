require 'json'

# nar8 — Fastlane iOS deployment
#
# Reads config from build.json:  { scheme, app_identifier, extensions }
# Reads creds from eas.json:     submit.production.ios

default_platform(:ios)

# ── Config helpers ──────────────────────────────────────────────────────

def build_config
  @build_config ||= begin
    path = File.expand_path('../build.json', FastlaneCore::FastlaneFolder.path)
    UI.user_error!("build.json not found at #{path}") unless File.exist?(path)
    JSON.parse(File.read(path))
  end
end

def eas_config
  @eas_config ||= begin
    path = File.expand_path('../eas.json', FastlaneCore::FastlaneFolder.path)
    File.exist?(path) ? JSON.parse(File.read(path)) : {}
  end
end

def app_scheme;      build_config['scheme']              end
def app_identifier;  build_config['app_identifier']      end
def app_extensions;  build_config['extensions'] || {}    end
def ios_workspace;   "./ios/#{app_scheme}.xcworkspace"   end
def ios_project;     "./ios/#{app_scheme}.xcodeproj"     end

def apple_team_id
  team = eas_config.dig('submit', 'production', 'ios', 'appleTeamId')
  team = nil if team.is_a?(String) && team.strip.empty?
  team || ENV['APPLE_TEAM_ID'] || ''
end

def require_team_id!
  id = apple_team_id
  if id.strip.empty?
    UI.user_error!(
      "Apple Team ID not set. Add appleTeamId to eas.json#submit.production.ios " \
      "or set APPLE_TEAM_ID in .env.local. Find it at https://developer.apple.com/account"
    )
  end
  id
end

# ── Lanes ───────────────────────────────────────────────────────────────

platform :ios do
  before_all { }

  desc "Build and upload to TestFlight"
  lane :beta do
    team_id = require_team_id!
    api_key = app_store_connect_api_key_from_env

    UI.message("📦 Running npm install...")
    sh("cd .. && npm install")
    UI.message("🔧 Running expo prebuild...")
    sh("cd .. && APP_VARIANT=production npx expo prebuild --platform ios --clean")
    UI.message("📦 Running pod install...")
    sh("cd ../ios && bundle exec pod install")
    UI.message("🔏 Setting development team #{team_id}...")
    update_project_team(path: ios_project, teamid: team_id)

    UI.message("📦 Syncing build number with App Store Connect...")
    asc_build   = app_store_build_number(app_identifier: app_identifier, live: false, api_key: api_key).to_i
    proj_build  = get_build_number(xcodeproj: ios_project).to_i
    next_build  = [asc_build, proj_build].max + 1
    UI.message("ASC: #{asc_build}, project: #{proj_build} → #{next_build}")
    increment_build_number(build_number: next_build, xcodeproj: ios_project)

    version = get_version_number(xcodeproj: ios_project, target: app_scheme)
    build   = get_build_number(xcodeproj: ios_project)
    UI.success("Building #{version} (#{build})")

    do_build_ios(skip_prebuild: true)

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.message("🚀 Uploading to TestFlight...")
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "Build #{build} — Automated via Fastlane"
    )
    UI.success("✅ Uploaded! Version #{version} (#{build}) — appears in TestFlight in ~5-10 min")
  end

  desc "Build iOS app only (no upload)"
  lane :build do
    do_build_ios(skip_package_ipa: false, export_method: "app-store")
    UI.success("✅ Build complete — #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  desc "Submit existing IPA to TestFlight"
  lane :submit do |options|
    api_key  = app_store_connect_api_key_from_env
    ipa_path = options[:ipa] ||
               lane_context[SharedValues::IPA_OUTPUT_PATH] ||
               File.expand_path("../build/#{app_scheme}.ipa", __dir__)
    UI.user_error!("No IPA found at #{ipa_path}") unless File.exist?(ipa_path)
    upload_to_testflight(
      api_key: api_key, ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false, notify_external_testers: false
    )
    UI.success("✅ Submitted to TestFlight!")
  end

  desc "Increment build number (synced with ASC)"
  lane :bump_build do
    asc_build  = app_store_build_number(app_identifier: app_identifier, live: false).to_i
    proj_build = get_build_number(xcodeproj: ios_project).to_i
    next_build = [asc_build, proj_build].max + 1
    increment_build_number(build_number: next_build, xcodeproj: ios_project)
    UI.success("Build → #{get_build_number(xcodeproj: ios_project)}")
  end

  # ── Private ─────────────────────────────────────────────────────────

  private_lane :do_build_ios do |options|
    team_id = require_team_id!

    unless options[:skip_prebuild]
      sh("cd .. && npm install")
      sh("cd .. && APP_VARIANT=production npx expo prebuild --platform ios --clean")
      sh("cd ../ios && bundle exec pod install")
      update_project_team(path: ios_project, teamid: team_id)
    end

    api_key = app_store_connect_api_key_from_env
    provisioning_profiles = {}

    get_provisioning_profile(app_identifier: app_identifier, team_id: team_id, api_key: api_key)
    provisioning_profiles[app_identifier] = ENV["sigh_#{app_identifier}_appstore_profile-uuid"]
    UI.success("Profile: #{ENV["sigh_#{app_identifier}_appstore_profile-name"]}")

    app_extensions.each do |ext_id, _|
      get_provisioning_profile(app_identifier: ext_id, team_id: team_id, api_key: api_key)
      provisioning_profiles[ext_id] = ENV["sigh_#{ext_id}_appstore_profile-uuid"]
    end

    gym(
      workspace: ios_workspace,
      scheme: app_scheme,
      export_method: "app-store",
      configuration: "Release",
      clean: true,
      output_directory: "./build",
      output_name: "#{app_scheme}.ipa",
      export_options: {
        method: "app-store",
        teamID: team_id,
        compileBitcode: false,
        provisioningProfiles: provisioning_profiles,
      },
      skip_package_ipa: options[:skip_package_ipa] || false,
    )
  end

  private_lane :app_store_connect_api_key_from_env do
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] &&
       ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] &&
       ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
      app_store_connect_api_key(
        key_id:       ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].strip,
        issuer_id:    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"].strip,
        key_filepath: File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"].strip),
      )
    else
      nil
    end
  end

  error do |lane, exception|
    UI.error("Lane '#{lane}' failed: #{exception.message}")
  end

  after_all do |lane|
    UI.success("Lane '#{lane}' completed!")
  end
end
